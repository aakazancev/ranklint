{
  "name": "@ranklint/cli",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "ranklint": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "unbuild",
    "dev:prepare": "unbuild --stub",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "unbuild": "^3.6.1"
  },
  "dependencies": {
    "@ranklint/checks": "workspace:*",
    "@ranklint/core": "workspace:*",
    "@ranklint/reporters": "workspace:*",
    "citty": "^0.2.2",
    "playwright": "^1.61.1"
  }
}
