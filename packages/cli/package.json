{
  "name": "@ranklint/cli",
  "version": "0.2.0",
  "description": "SEO audit CLI: crawl a deployed site with real Chrome, run 42 checks, Lighthouse, diff between branches, production monitoring.",
  "keywords": [
    "seo",
    "lint",
    "cli",
    "audit",
    "lighthouse",
    "crawler"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aakazancev/ranklint.git",
    "directory": "packages/cli"
  },
  "homepage": "https://aakazancev.github.io/ranklint/",
  "bugs": "https://github.com/aakazancev/ranklint/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./cli": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "ranklint": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "unbuild",
    "dev:prepare": "unbuild --stub",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1080.0",
    "@ranklint/preset-default": "workspace:*",
    "@types/node": "^26.1.0",
    "unbuild": "^3.6.1"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "dependencies": {
    "@ranklint/checks": "workspace:*",
    "@ranklint/core": "workspace:*",
    "@ranklint/reporters": "workspace:*",
    "chokidar": "^5.0.0",
    "chrome-launcher": "^1.2.1",
    "citty": "^0.2.2",
    "lighthouse": "^13.4.0",
    "playwright": "^1.61.1"
  }
}
