{
  "name": "@ranklint/reporters",
  "version": "0.1.1",
  "description": "Report formats for ranklint: markdown, json, junit, gitlab, html, github annotations, diff and alert payloads.",
  "keywords": [
    "seo",
    "reporter",
    "junit",
    "gitlab"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aakazancev/ranklint.git",
    "directory": "packages/reporters"
  },
  "homepage": "https://aakazancev.github.io/ranklint/",
  "bugs": "https://github.com/aakazancev/ranklint/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev:prepare": "unbuild --stub",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "unbuild": "^3.6.1"
  },
  "dependencies": {
    "@ranklint/core": "workspace:*"
  }
}
