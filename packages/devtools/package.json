{
  "name": "@ranklint/devtools",
  "version": "0.2.0",
  "description": "Nuxt DevTools panel for ranklint: live SEO checks of the current page.",
  "keywords": [
    "nuxt",
    "devtools",
    "seo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aakazancev/ranklint.git",
    "directory": "packages/devtools"
  },
  "homepage": "https://aakazancev.github.io/ranklint/",
  "bugs": "https://github.com/aakazancev/ranklint/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev:prepare": "unbuild",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ranklint/checks": "workspace:*",
    "@ranklint/core": "workspace:*"
  },
  "devDependencies": {
    "@nuxt/devtools-kit": "^3.2.4",
    "@types/node": "^26.1.0",
    "happy-dom": "^20.0.11",
    "linkedom": "^0.18.12",
    "unbuild": "^3.6.1",
    "vue": "^3.5.39"
  }
}
