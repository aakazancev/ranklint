{
  "name": "ranklint",
  "version": "0.3.0",
  "description": "Lint your SEO before Google does. Alias for @ranklint/cli — the SEO audit CLI for Nuxt 4 sites.",
  "keywords": [
    "seo",
    "lint",
    "cli",
    "audit",
    "nuxt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aakazancev/ranklint.git",
    "directory": "packages/ranklint"
  },
  "homepage": "https://aakazancev.github.io/ranklint/",
  "bugs": "https://github.com/aakazancev/ranklint/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "default": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "bin.mjs"
  ],
  "bin": {
    "ranklint": "./bin.mjs"
  },
  "dependencies": {
    "@ranklint/cli": "workspace:*"
  }
}
