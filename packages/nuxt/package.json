{
  "name": "@ranklint/nuxt",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/test-utils": "^4.0.3",
    "nuxt": "^4.4.8"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.8",
    "@ranklint/checks": "workspace:*",
    "linkedom": "^0.18.12"
  }
}
