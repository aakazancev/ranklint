{
  "name": "@ranklint/nuxt",
  "version": "0.1.1",
  "description": "Nuxt 4 SEO module: sitemap.xml, robots.txt, typed JSON-LD and a live SEO panel in Nuxt DevTools.",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "seo",
    "sitemap",
    "robots",
    "json-ld"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aakazancev/ranklint.git",
    "directory": "packages/nuxt"
  },
  "homepage": "https://aakazancev.github.io/ranklint/",
  "bugs": "https://github.com/aakazancev/ranklint/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/test-utils": "^4.0.3",
    "nuxt": "^4.4.8"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.8",
    "@ranklint/checks": "workspace:*",
    "@ranklint/core": "workspace:*",
    "@ranklint/devtools": "workspace:*"
  }
}
