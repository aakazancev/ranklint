{
  "name": "@ranklint/core",
  "version": "0.4.0",
  "description": "Ranklint engine: crawler, check runner, config loader, diff and report storages. No Nuxt or Playwright dependencies.",
  "keywords": [
    "seo",
    "lint",
    "crawler",
    "audit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aakazancev/ranklint.git",
    "directory": "packages/core"
  },
  "homepage": "https://aakazancev.github.io/ranklint/",
  "bugs": "https://github.com/aakazancev/ranklint/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev:prepare": "unbuild --stub",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "unbuild": "^3.6.1"
  },
  "dependencies": {
    "c12": "4.0.0-beta.5",
    "defu": "^6.1.7",
    "linkedom": "^0.18.12",
    "zod": "^4.4.3"
  }
}
