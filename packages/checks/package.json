{
  "name": "@ranklint/checks",
  "version": "0.3.0",
  "description": "42 built-in SEO rules for ranklint plus Schema.org validation schemas.",
  "keywords": [
    "seo",
    "lint",
    "rules",
    "schema-org"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aakazancev/ranklint.git",
    "directory": "packages/checks"
  },
  "homepage": "https://aakazancev.github.io/ranklint/",
  "bugs": "https://github.com/aakazancev/ranklint/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./schema-org": {
      "types": "./dist/schema-org.d.mts",
      "import": "./dist/schema-org.mjs",
      "default": "./dist/schema-org.mjs"
    },
    "./level1": {
      "types": "./dist/level1.d.mts",
      "import": "./dist/level1.mjs",
      "default": "./dist/level1.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev:prepare": "unbuild --stub",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "unbuild": "^3.6.1"
  },
  "dependencies": {
    "@ranklint/core": "workspace:*",
    "linkedom": "^0.18.12",
    "zod": "^4.4.3"
  }
}
