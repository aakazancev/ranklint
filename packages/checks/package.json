{
  "name": "@ranklint/checks",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./schema-org": {
      "types": "./dist/schema-org.d.mts",
      "import": "./dist/schema-org.mjs"
    },
    "./level1": {
      "types": "./dist/level1.d.mts",
      "import": "./dist/level1.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev:prepare": "unbuild --stub",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "unbuild": "^3.6.1"
  },
  "dependencies": {
    "@ranklint/core": "workspace:*",
    "linkedom": "^0.18.12",
    "zod": "^4.4.3"
  }
}
