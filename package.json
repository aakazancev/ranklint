{
  "name": "ranklint-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev:prepare": "pnpm -r --filter './packages/*' dev:prepare && pnpm --filter ranklint-playground exec nuxt prepare",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter './packages/*' typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@nuxt/eslint-config": "^1.16.0",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
