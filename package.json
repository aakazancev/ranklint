{
  "name": "ranklint-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev:prepare": "pnpm -r --filter './packages/*' dev:prepare && pnpm --filter ranklint-playground exec nuxt prepare && pnpm --filter ranklint-docs dev:prepare",
    "docs:dev": "pnpm --filter ranklint-docs dev",
    "docs:generate": "pnpm --filter ranklint-docs generate",
    "test": "vitest run",
    "landing:shots": "node scripts/landing-shots.mjs",
    "landing:gate": "node scripts/landing-gate.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "publint": "pnpm -r --filter './packages/*' exec publint",
    "release:version": "changeset version && pnpm install --no-frozen-lockfile"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@nuxt/eslint-config": "^1.16.0",
    "eslint": "^10.6.0",
    "publint": "^0.3.21",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
